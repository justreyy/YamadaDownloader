# Salin ke Vercel > Project > Settings > Environment Variables (jangan di-commit nilai aslinya).

# WAJIB. Key untuk login Panel Admin. Tidak ada nilai bawaan: kalau kosong, panel admin nonaktif.
# Pakai kalimat acak yang panjang (minimal 16 karakter).
ADMIN_PANEL_KEY=

# Opsional. Secret penanda sesi admin. Ganti nilainya untuk memutus semua sesi admin yang sedang login.
ADMIN_SESSION_SECRET=

# Vercel KV / Upstash Redis (Storage > Create Database). Tanpa ini pengaturan & statistik admin tidak tersimpan.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Opsional. Bawaan: https://api.nexray.eu.cc/downloader/aio
DOWNLOADER_API_URL=
# Opsional. Bawaan: https://api.nexray.eu.cc/downloader/pinterest
PINTEREST_API_URL=

# WAJIB kalau fitur Remove Background dipakai. Dari https://www.remove.bg/api
REMOVE_BG_API_KEY=
